<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', { title: 'Your games — Chess Companion' }) %>
  </head>
  <body>
    <%- include('partials/navbar') %>
    <div class="container">
      <header class="page-head page-head--action">
        <div>
          <h1>Your games</h1>
        </div>
        <a class="btn" href="/import">Import games</a>
      </header>

      <% if (summary) { %>
        <div class="alert alert--info">
          <span class="label">Import finished</span>
          <% if (summary.imported + summary.skipped + summary.failed === 0) { %>
            No new games since your last import.
          <% } else { %>
            <%= summary.imported %> new game<%= summary.imported === 1 ? '' : 's' %> added<% if (summary.skipped) { %>, <%= summary.skipped %> already in your library<% } %><% if (summary.failed) { %>, <%= summary.failed %> could not be read<% } %>.
          <% } %>
        </div>
      <% } %>

      <% if (games.length > 0) { %>
        <ul class="games-list">
          <% games.forEach(game => { %>
            <li class="game-card">
              <div class="game-info">
                <% if (game.outcome) { %>
                  <span class="outcome outcome--<%= game.outcome %> mono" title="<%= game.outcome %>"><%= game.outcome[0].toUpperCase() %></span>
                <% } %>
                <div>
                  <a href="/games/<%= game.id %>">
                    <% if (game.user_color) { %>
                      <span class="muted">vs</span> <%= game.opponent %>
                      <% if (game.opponentElo) { %><span class="muted mono">(<%= game.opponentElo %>)</span><% } %>
                    <% } else { %>
                      <%= game.white_player %>
                      <span class="muted">vs</span>
                      <%= game.black_player %>
                      <span class="muted mono">— <%= game.result %></span>
                    <% } %>
                  </a>
                  <div class="game-meta">
                    <% if (game.user_color) { %>
                      <span><%= game.user_color === 'w' ? '○ White' : '● Black' %></span>
                    <% } else { %>
                      <span>side unknown</span>
                    <% } %>
                    <% if (game.date_played) { %><span><%= game.date_played %></span><% } %>
                    <% if (game.opening) { %><span class="game-opening"><%= game.opening %></span><% } %>
                  </div>
                </div>
              </div>
              <div class="game-status">
                <% if (!game.user_color) { %>
                  <form method="POST" action="/games/<%= game.id %>/side" class="row-side-picker">
                    <input type="hidden" name="back" value="list" />
                    <span class="muted">You were</span>
                    <button class="btn-chip" type="submit" name="color" value="w">○ White</button>
                    <button class="btn-chip" type="submit" name="color" value="b">● Black</button>
                  </form>
                <% } else if (game.analyzed_at) { %>
                  <%- include('partials/error-counts', { game }) %>
                <% } else { %>
                  <button type="button" class="btn-chip" data-start-analysis>Analyze</button>
                <% } %>
              </div>
              <form method="POST" action="/games/<%= game.id %>/delete">
                <button class="btn-danger" type="submit" aria-label="Delete game">×</button>
              </form>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <div class="empty-state">
          <h2>No games yet.</h2>
          <p>Connect your Lichess or Chess.com account and your recent games come in with one click. They're stored privately to your account.</p>
          <a class="btn btn-primary" href="/import">Connect &amp; import</a>
        </div>
      <% } %>
    </div>
  </body>
</html>
