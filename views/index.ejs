<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', { title: 'Chess Companion' }) %>
  </head>
  <body>
    <%- include('partials/navbar') %>
    <div class="container container--narrow">
      <section class="hero">
        <h1>Train on the mistakes you actually make.</h1>
        <p class="lead">
          Bring in your Lichess and Chess.com games. Stockfish finds where you
          went wrong, those positions come back as drills until they stick, and
          bot games lead you straight back into them. No generic puzzles: only
          your own weak spots.
        </p>
        <div class="cta-row">
          <% if (userId) { %>
            <a class="btn btn-primary" href="/train">Start training</a>
            <a href="/insights">See your weak spots →</a>
          <% } else { %>
            <a class="btn btn-primary" href="/register">Get started</a>
            <a href="/login">Already have an account?</a>
          <% } %>
        </div>
      </section>
      <%- include('partials/credit') %>
    </div>
  </body>
</html>
