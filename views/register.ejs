<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', { title: 'Sign up — Chess Companion' }) %>
  </head>
  <body>
    <%- include('partials/navbar') %>
    <div class="container container--narrow">
      <header class="page-head rise rise-1">
        <span class="eyebrow">New Player</span>
        <h1>Create an account</h1>
      </header>

      <% if (error) { %>
        <div class="alert rise rise-2">
          <span class="label">Error</span>
          <%= error %>
        </div>
      <% } %>

      <form method="POST" action="/register" class="rise rise-2">
        <div>
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="you@example.com" required />
        </div>
        <div>
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="A strong password" required />
        </div>
        <button class="btn btn-primary" type="submit">Sign Up</button>
      </form>

      <p class="rise rise-3" style="margin-top: var(--space-5); color: var(--ink-muted);">
        Already have an account? <a href="/login">Sign in</a>.
      </p>
    </div>
  </body>
</html>
