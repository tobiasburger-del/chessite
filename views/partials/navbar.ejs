<% const path = (typeof currentPath !== 'undefined') ? currentPath : ''; %>
<% const navLink = (href, label, active) => `<li><a href="${href}" class="${active ? 'is-active' : ''}">${label}</a></li>`; %>
<nav class="masthead">
  <a href="/" class="wordmark"><span class="glyph">♞</span>Chess Companion</a>
  <% if (userId) { %>
    <ul>
      <%- navLink('/', 'Today', path === '/') %>
      <%- navLink('/games', 'Games', path.startsWith('/games') || path === '/import') %>
      <%- navLink('/train', 'Train', path.startsWith('/train')) %>
      <%- navLink('/play', 'Play', path.startsWith('/play')) %>
      <%- navLink('/insights', 'Insights', path.startsWith('/insights')) %>
    </ul>
    <a id="queue-status" class="queue-status mono" href="/games" data-user-id="<%= userId %>" hidden></a>
    <details class="account-menu">
      <summary>Account</summary>
      <div class="account-pop">
        <a href="/import">Connect &amp; import</a>
        <a href="/settings">Settings</a>
        <form method="POST" action="/logout">
          <button type="submit">Log out</button>
        </form>
      </div>
    </details>
    <script src="/js/uci-parsers.js"></script>
    <script src="/js/moveClassifier.js"></script>
    <script type="module" src="/js/analysisQueue.js"></script>
  <% } else { %>
    <ul></ul>
    <a href="/login" class="btn-ghost" style="text-decoration:none;">Sign In</a>
  <% } %>
</nav>
