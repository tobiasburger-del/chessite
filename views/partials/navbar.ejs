<% const path = (typeof currentPath !== 'undefined') ? currentPath : ''; %>
<nav class="masthead">
  <a href="/" class="wordmark"><span class="glyph">♞</span>Chess Companion</a>
  <ul>
    <li><a href="/" class="<%= path === '/' ? 'is-active' : '' %>">Home</a></li>
    <li><a href="/games" class="<%= path.startsWith('/games') ? 'is-active' : '' %>">Games</a></li>
    <li><a href="/import" class="<%= path === '/import' ? 'is-active' : '' %>">Import</a></li>
  </ul>
  <% if (userId) { %>
    <form method="POST" action="/logout">
      <button class="btn-ghost" type="submit">Log Out</button>
    </form>
  <% } else { %>
    <a href="/login" class="btn-ghost" style="text-decoration:none;">Sign In</a>
  <% } %>
</nav>
