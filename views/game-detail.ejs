<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', { title: 'Game — Chess Companion' }) %>
    <link rel="stylesheet" href="/vendor/cm-chessboard/assets/chessboard.css" />
    <link rel="stylesheet" href="/vendor/cm-chessboard/assets/extensions/markers/markers.css" />
  </head>
  <body>
    <%- include('partials/navbar') %>
    <div class="container">
      <% if (game) { %>
        <header class="game-head">
          <h1>
            <%= game.white_player %><% if (game.white_elo) { %> <span class="elo mono">(<%= game.white_elo %>)</span><% } %>
            <span class="muted">vs</span>
            <%= game.black_player %><% if (game.black_elo) { %> <span class="elo mono">(<%= game.black_elo %>)</span><% } %>
          </h1>
          <p class="game-head-meta muted">
            <span class="mono"><%= game.result %></span>
            <% if (game.user_color) { %><span>You played <%= game.user_color === 'w' ? 'White' : 'Black' %></span><% } %>
            <% if (displayDate(game.date_played)) { %><span><%= displayDate(game.date_played) %></span><% } %>
            <% if (game.opening) { %><span><%= game.opening %></span><% } %>
            <% if (game.site && /^https?:\/\//.test(game.site)) { %><a href="<%= game.site %>">Open on <%= game.site.includes('lichess') ? 'Lichess' : 'the site' %></a><% } %>
          </p>
        </header>


        <% if (!game.user_color) { %>
          <form method="POST" action="/games/<%= game.id %>/side" class="side-picker">
            <span>Which side were you? Training only looks at your moves.</span>
            <button class="btn" type="submit" name="color" value="w">○ White</button>
            <button class="btn" type="submit" name="color" value="b">● Black</button>
          </form>
        <% } %>

        <section class="analysis" data-pgn="<%= game.pgn_raw %>" data-orientation="<%= game.user_color || 'w' %>" data-game-id="<%= game.id %>" data-start-eval="<%= game.start_eval_cp ?? '' %>">
          <div class="board-stage">
            <div class="board-frame-wrap">
              <div id="eval-bar" aria-hidden="true">
                <div class="eb-black"></div>
                <div class="eb-white"></div>
              </div>
              <div class="board-frame">
                <div id="board"></div>
              </div>
            </div>

            <div class="board-transport" role="group" aria-label="Move navigation">
              <button type="button" class="tr-btn" data-nav="start" aria-label="First move">|◀</button>
              <span class="tr-rule" aria-hidden="true"></span>
              <button type="button" class="tr-btn" data-nav="prev" aria-label="Previous move">◀</button>
              <span class="tr-rule" aria-hidden="true"></span>
              <button type="button" class="tr-btn" data-nav="next" aria-label="Next move">▶</button>
              <span class="tr-rule" aria-hidden="true"></span>
              <button type="button" class="tr-btn" data-nav="end" aria-label="Last move">▶|</button>
            </div>

            <div class="readout-row mono">
              <button type="button" id="next-error" class="next-error" hidden>Next error ▶</button>
              <div class="ply-readout">
                <span id="ply-current">0</span>
                <span class="ply-sep">/</span>
                <span id="ply-total"><%= moves.length %></span>
              </div>
              <span id="eval-readout" aria-label="Engine evaluation">…</span>
            </div>

            <div id="move-note" class="move-note" aria-live="polite"></div>
          </div>

          <div class="move-panel">
            <% if (moves.length > 0) { %>
              <div class="review-panel">
                <% if (summary) { %>
                  <table class="review-summary mono">
                    <thead>
                      <tr><th></th><th title="Accuracy">Acc.</th><th title="Inaccuracies">?!</th><th title="Mistakes">?</th><th title="Blunders">??</th></tr>
                    </thead>
                    <tbody>
                      <% summary.forEach(row => { %>
                        <tr class="<%= row.isYou ? 'is-you' : '' %>">
                          <th scope="row"><%= row.label %></th>
                          <td class="acc"><%= row.accuracy == null ? '—' : row.accuracy + '%' %></td>
                          <td class="cls-inaccuracy"><%= row.counts.inaccuracy %></td>
                          <td class="cls-mistake"><%= row.counts.mistake %></td>
                          <td class="cls-blunder"><%= row.counts.blunder %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                  <svg id="eval-graph" class="eval-graph" role="img" aria-label="Evaluation over the game. Click to jump to a move."></svg>
                  <% if (drillCount > 0) { %>
                    <a class="btn btn-primary review-drill" href="/train?spot=game:<%= game.id %>">Drill the <%= drillCount %> mistake<%= drillCount === 1 ? '' : 's' %> from this game →</a>
                  <% } %>
                  <div class="review-actions">
                    <span class="muted">Stockfish depth <%= game.analysis_depth %></span>
                    <button type="button" id="analyze-btn" class="btn-link"><%= needsComments ? 'Re-analyze to explain every move' : 'Re-analyze' %></button>
                  </div>
                <% } else { %>
                  <p class="review-intro">
                    Find your mistakes: Stockfish checks every move, right here in your browser.
                  </p>
                  <button type="button" id="analyze-btn" class="btn btn-primary">Analyze game</button>
                <% } %>
                <div id="analyze-progress" class="analyze-progress" hidden>
                  <div class="analyze-progress-bar"><span></span></div>
                  <span class="analyze-progress-text"></span>
                </div>
              </div>
            <% } %>

            <h3>Moves</h3>
            <% if (moves.length === 0) { %>
              <p class="muted" style="font-style: italic;">No moves recorded for this game.</p>
            <% } else { %>
              <ol class="move-table mono">
                <% rows.forEach(row => { %>
                  <li class="move-row">
                    <span class="move-num"><%= row.number %>.</span>
                    <% [row.w, row.b].forEach(move => { %>
                      <% if (move) { %>
                        <button type="button" class="move-cell <%= move.classification ? 'cls-' + move.classification : '' %> <%= move.isReplayed ? 'is-replayed' : '' %>"
                          data-ply="<%= move.ply %>"
                          data-classification="<%= move.classification || '' %>"
                          data-best-san="<%= move.best_san || '' %>"
                          data-best-move="<%= move.best_move || '' %>"
                          data-eval-cp="<%= move.eval_cp ?? '' %>"
                          data-eval-mate="<%= move.eval_mate ?? '' %>"
                          data-drill-id="<%= move.drillId || '' %>"
                          data-comment="<%= move.comment || '' %>"
                          data-mine="<%= move.isMine ? '1' : '' %>"
                          data-replayed="<%= move.isReplayed ? '1' : '' %>"><%= move.san %><span class="move-mark" aria-hidden="true"></span></button>
                      <% } else { %>
                        <span class="move-cell is-empty">…</span>
                      <% } %>
                    <% }) %>
                  </li>
                <% }) %>
              </ol>
            <% } %>
          </div>
        </section>


        <section>
          <div class="notes-head">
            <h3 style="margin: 0;">Notes</h3>
            <span id="save-status"></span>
          </div>
          <form method="POST" action="/games/<%= game.id %>/edit">
            <textarea id="notes" name="notes" data-game-id="<%= game.id %>" placeholder="Annotate the game — your plans, your mistakes, what you'd do differently."><%= game.notes %></textarea>
          </form>
        </section>

        <script src="/js/uci-parsers.js"></script>
        <script src="/js/moveClassifier.js"></script>
        <script src="/js/explain.js"></script>
        <script src="/js/boardRules.js"></script>
        <script type="module" src="/js/board.js"></script>
        <script type="module" src="/js/notes.js"></script>
      <% } else { %>
        <div class="empty-state">
          <h2>Game not found.</h2>
          <p>This game doesn't exist, or it isn't yours to view.</p>
          <a class="btn btn-primary" href="/games">Back to your library</a>
        </div>
      <% } %>
    </div>
  </body>
</html>
