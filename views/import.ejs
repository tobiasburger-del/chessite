<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', { title: 'Import — Chess Companion' }) %>
  </head>
  <body>
    <%- include('partials/navbar') %>
    <div class="container container--narrow">
      <header class="page-head rise rise-1">
        <span class="eyebrow">Bring a Game In</span>
        <h1>Import from PGN</h1>
        <p class="muted" style="margin-top: var(--space-3);">
          Paste the PGN of a game from Lichess, Chess.com, or any database.
          We'll parse the moves and metadata, and stage it for annotation.
        </p>
      </header>

      <form method="POST" action="/games" class="rise rise-2">
        <div>
          <label for="pgn">PGN</label>
          <textarea
            id="pgn"
            name="pgn"
            placeholder="[Event &quot;Casual Game&quot;]&#10;[White &quot;You&quot;]&#10;[Black &quot;Opponent&quot;]&#10;1. e4 e5 2. Nf3 Nc6 ..."
          ></textarea>
        </div>
        <button class="btn btn-primary" type="submit">Import Game</button>
      </form>
    </div>
  </body>
</html>
