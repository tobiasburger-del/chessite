<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', { title: 'Connect & Import — Chess Companion' }) %>
  </head>
  <body>
    <%- include('partials/navbar') %>
    <div class="container container--narrow">
      <header class="page-head rise rise-1">
        <span class="eyebrow">Bring Games In</span>
        <h1>Connect &amp; import</h1>
        <p class="muted" style="margin-top: var(--space-3);">
          Connect your Lichess or Chess.com account and your games come in with
          one click. We only read your public games; no password needed.
        </p>
      </header>

      <% if (error) { %>
        <div class="alert rise rise-2">
          <span class="label">Error</span>
          <%= error %>
        </div>
      <% } %>

      <div class="connect-grid rise rise-2">
        <% accounts.forEach(a => { %>
          <form method="POST" action="/import/online" class="connect-card js-busy-form <%= a.name ? 'is-connected' : '' %>">
            <input type="hidden" name="source" value="<%= a.source %>" />
            <h2 class="connect-site"><%= a.label %></h2>
            <% if (a.name) { %>
              <p class="connect-status">
                <span class="label">Connected</span>
                <span class="mono connect-user"><%= a.name %></span>
              </p>
              <p class="muted mono connect-count"><%= a.games %> game<%= a.games === 1 ? '' : 's' %> imported</p>
              <button class="btn btn-primary" type="submit" data-busy="Importing…">Import latest games</button>
              <a class="connect-change" href="/settings">Change username</a>
            <% } else { %>
              <label for="username-<%= a.source %>">Your <%= a.label %> username</label>
              <input type="text" id="username-<%= a.source %>" name="username" required
                pattern="[A-Za-z0-9_\-]{2,30}" autocomplete="off" spellcheck="false" />
              <button class="btn btn-primary" type="submit" data-busy="Connecting…">Connect &amp; import</button>
              <p class="muted connect-hint">Imports your latest 50 games.</p>
            <% } %>
          </form>
        <% }) %>
      </div>

      <details class="pgn-fallback rise rise-3" <%= pgnOpen ? 'open' : '' %>>
        <summary>Have a PGN? Paste it here</summary>
        <form method="POST" action="/games" class="js-busy-form">
          <div>
            <label for="pgn">PGN — one game or several</label>
            <textarea
              id="pgn"
              name="pgn"
              placeholder="[Event &quot;Casual Game&quot;]&#10;[White &quot;You&quot;]&#10;[Black &quot;Opponent&quot;]&#10;1. e4 e5 2. Nf3 Nc6 ..."
            ></textarea>
          </div>
          <button class="btn" type="submit" data-busy="Importing…">Import PGN</button>
        </form>
      </details>
    </div>
    <script src="/js/busyForm.js"></script>
  </body>
</html>
